# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Facility local timezone (Avon Lake, OH)
NEXT_PUBLIC_TIMEZONE=America/New_York

# Public site URL (magic-link redirect). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: auto-email coach schedules FROM Google Workspace (tryouts@altbsa.org)
# via Gmail API OAuth. Same mailbox coaches already know; not related to magic-link
# login (Supabase still owns sign-in emails). Without these, the button opens a
# mailto compose + downloads an .ics file.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_SENDER=tryouts@altbsa.org
# EMAIL_FROM=ALTBSA Scheduler <tryouts@altbsa.org>
#
# Optional alternate provider:
# RESEND_API_KEY=re_xxxxxxxxx
